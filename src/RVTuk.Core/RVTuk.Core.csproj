<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RVTuk.Core</AssemblyName>
    <RootNamespace>RVTuk.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Microsoft.Data.Sqlite on every framework. Unlike System.Data.SQLite, its bundled
       e_sqlite3 can open databases over UNC shares (\\server\share); System.Data.SQLite's
       win32 VFS fails ("unable to open database file") against some SMB servers even though
       the file is readable.
       No System.Text.Json package: in-box on net8 and net10; on net48 its transitive polyfills
       (System.Memory, System.Runtime.CompilerServices.Unsafe, etc.) conflict with Revit's
       preloaded versions, so JSON uses DataContractJsonSerializer there. The native
       e_sqlite3.dll and any polyfill DLLs are handled by Deploy.ps1 (copied / stripped). -->
  <!-- Microsoft.Data.Sqlite pinned to 8.0.29: 8.0.30+ pulls SQLitePCLRaw 2.1.12,
       whose net461 build targets copy runtimes\win-arm\native\e_sqlite3.dll, a file that
       package does not ship, so every net48 build fails with MSB3030. 8.0.29 brings 2.1.6. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
  </ItemGroup>

  <!-- OpenMCDF pinned to 3.1.2 to match the version preloaded by other Revit addins. -->
  <ItemGroup>
    <PackageReference Include="OpenMCDF" Version="3.1.2" />
  </ItemGroup>

  <!-- Verbatim HEADER/TABLES/BLOCKS preamble and OBJECTS postamble for DxfWriter, captured
       from the real Rishui Zamin sample (tests/Examples Autoarea/Garmoshka.dxf) — see
       DxfWriter.cs remarks. -->
  <ItemGroup>
    <EmbeddedResource Include="RishuiZamin\DxfTemplates\Preamble.dxf">
      <LogicalName>RVTuk.Core.RishuiZamin.DxfTemplates.Preamble.dxf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="RishuiZamin\DxfTemplates\Postamble.dxf">
      <LogicalName>RVTuk.Core.RishuiZamin.DxfTemplates.Postamble.dxf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- net48: System.Drawing is a GAC assembly in .NET Framework — no NuGet needed.
       System.Drawing.Common 8.x would drag in Unsafe 6.x / System.Memory polyfills
       that conflict with Revit's preloaded versions. -->
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- net48: ZipFile/ZipArchive for the DWG transmittal live in these GAC assemblies.
       Framework assemblies, so no NuGet and no polyfills to clash with Revit's preloads;
       net8 has both in-box. -->
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <!-- Everything but net48: the System.Drawing.Common of the runtime's own version
       (8.0.* on net8, 10.0.* on net10). net48 takes System.Drawing from the GAC. -->
  <ItemGroup Condition="'$(TargetFramework)'!='net48'">
    <PackageReference Include="System.Drawing.Common" Version="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)', 2)).*" />
  </ItemGroup>

</Project>
