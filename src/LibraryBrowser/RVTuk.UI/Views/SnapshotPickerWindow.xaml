<Window x:Class="RVTuk.UI.Views.SnapshotPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Load saved snapshot"
        Width="560" Height="360" MinWidth="420" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RVTuk.UI;component/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Background><StaticResource ResourceKey="Brush.Bg"/></Window.Background>
    <Window.Foreground><StaticResource ResourceKey="Brush.Text"/></Window.Foreground>

    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="Saved project snapshots" Margin="2,0,0,6"
                   FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextMuted}"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Padding="10,4" Margin="0,0,6,0" Click="Cancel_Click"/>
            <Button x:Name="LoadButton" Content="Load ▶" Padding="10,4"
                    Background="{StaticResource Brush.Accent}" Foreground="Black"
                    IsEnabled="False" Click="Load_Click"/>
        </StackPanel>

        <DataGrid x:Name="List" ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionMode="Single" SelectionChanged="List_SelectionChanged"
                  MouseDoubleClick="List_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Captured" Binding="{Binding CapturedDisplay}" Width="150"/>
                <DataGridTextColumn Header="Rvt" Binding="{Binding RevitYear}" Width="50"/>
                <DataGridTemplateColumn Header="" Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🗑" Padding="4,0" Background="Transparent" BorderThickness="0"
                                    Click="Delete_Click" ToolTip="Delete this saved snapshot"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
