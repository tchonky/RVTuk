<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RVTuk.Core</AssemblyName>
    <RootNamespace>RVTuk.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release2023'">
    <TargetFramework>net48</TargetFramework>
    <OutputPath>bin\2023\Release2023\</OutputPath>
    <DefineConstants>REVIT2023</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release2024'">
    <TargetFramework>net48</TargetFramework>
    <OutputPath>bin\2024\Release2024\</OutputPath>
    <DefineConstants>REVIT2024</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'!='Release2024' and '$(Configuration)'!='Release2023'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputPath>bin\2025\Release2025\</OutputPath>
    <DefineConstants>REVIT2025</DefineConstants>
  </PropertyGroup>

  <!-- net48 (Revit 2023/2024): Microsoft.Data.Sqlite — same engine as net8. Unlike
       System.Data.SQLite, its bundled e_sqlite3 can open databases over UNC shares
       (\\server\share); System.Data.SQLite's win32 VFS fails ("unable to open database
       file") against some SMB servers even though the file is readable.
       No System.Text.Json on net48 — its transitive polyfills (System.Memory,
       System.Runtime.CompilerServices.Unsafe, etc.) conflict with Revit's preloaded
       versions; JSON uses DataContractJsonSerializer instead. The native e_sqlite3.dll
       and any polyfill DLLs are handled by Deploy.ps1 (copied / stripped). -->
  <!-- Microsoft.Data.Sqlite pinned to 8.0.29 (both targets): 8.0.30+ pulls SQLitePCLRaw 2.1.12,
       whose net461 build targets copy runtimes\win-arm\native\e_sqlite3.dll, a file that
       package does not ship, so every net48 build fails with MSB3030. 8.0.29 brings 2.1.6. -->
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
  </ItemGroup>

  <!-- net8.0-windows (Revit 2025): Microsoft.Data.Sqlite + System.Text.Json are fine here -->
  <ItemGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
    <PackageReference Include="System.Text.Json" Version="8.0.*" />
  </ItemGroup>

  <!-- OpenMCDF pinned to 3.1.2 to match the version preloaded by other Revit addins. -->
  <ItemGroup>
    <PackageReference Include="OpenMCDF" Version="3.1.2" />
  </ItemGroup>

  <!-- Verbatim HEADER/TABLES/BLOCKS preamble and OBJECTS postamble for DxfWriter, captured
       from the real Rishui Zamin sample (tests/Examples Autoarea/Garmoshka.dxf) — see
       DxfWriter.cs remarks. -->
  <ItemGroup>
    <EmbeddedResource Include="RishuiZamin\DxfTemplates\Preamble.dxf">
      <LogicalName>RVTuk.Core.RishuiZamin.DxfTemplates.Preamble.dxf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="RishuiZamin\DxfTemplates\Postamble.dxf">
      <LogicalName>RVTuk.Core.RishuiZamin.DxfTemplates.Postamble.dxf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- net48: System.Drawing is a GAC assembly in .NET Framework — no NuGet needed.
       System.Drawing.Common 8.x would drag in Unsafe 6.x / System.Memory polyfills
       that conflict with Revit's preloaded versions. -->
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- net48: ZipFile/ZipArchive for the DWG transmittal live in these GAC assemblies.
       Framework assemblies, so no NuGet and no polyfills to clash with Revit's preloads;
       net8 has both in-box. -->
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <!-- net8.0: System.Drawing.Common NuGet provides GDI+ access on non-Windows or without WPF -->
  <ItemGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <PackageReference Include="System.Drawing.Common" Version="8.0.*" />
  </ItemGroup>

</Project>
