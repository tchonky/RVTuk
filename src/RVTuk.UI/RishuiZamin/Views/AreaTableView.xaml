<UserControl x:Class="RVTuk.UI.RishuiZamin.Views.AreaTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:RVTuk.UI.Shared.Themes"
             xmlns:views="clr-namespace:RVTuk.UI.RishuiZamin.Views">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:DarkThemeDictionary/>
            </ResourceDictionary.MergedDictionaries>
            <views:LimitStatusBrushConverter x:Key="StatusBrush"
                                             Ok="{StaticResource Brush.UsagePrimary}"
                                             Close="{StaticResource Brush.UsageProcess}"
                                             Over="{StaticResource Brush.Warning}"
                                             NotChecked="{StaticResource Brush.TextMuted}"/>
            <Style x:Key="LimitBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Margin" Value="3,0,8,0"/>
                <Setter Property="Padding" Value="3,1"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <EventSetter Event="KeyDown" Handler="LimitBox_KeyDown"/>
                <EventSetter Event="LostKeyboardFocus" Handler="LimitBox_LostFocus"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}"/>
                        <Setter Property="ToolTip" Value="Not a number (use . for decimals)"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="8" Background="{StaticResource Brush.Panel}">
            <WrapPanel Margin="0,0,0,6">
                <Button Content="⟳ Refresh" Command="{Binding RefreshCommand}" Margin="0,0,10,0" Padding="10,5"/>
                <TextBlock Text="Plot area" Style="{StaticResource Label}"/>
                <TextBox DataContext="{Binding PlotAreaBox}" Width="80" Style="{StaticResource LimitBox}" Margin="3,0,2,0"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="m²" Style="{StaticResource Label}" Margin="0,0,10,0"/>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,6">
                <TextBlock Text="Allowed % of plot:" Style="{StaticResource Label}" Margin="0,0,6,0"/>
                <TextBlock Text="Primary" Style="{StaticResource Label}" Foreground="{StaticResource Brush.UsagePrimary}"/>
                <TextBox DataContext="{Binding PrimaryLimitBox}" Width="45" Style="{StaticResource LimitBox}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Service" Style="{StaticResource Label}" Foreground="{StaticResource Brush.UsageService}"/>
                <TextBox DataContext="{Binding ServiceLimitBox}" Width="45" Style="{StaticResource LimitBox}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Total" Style="{StaticResource Label}"/>
                <TextBox DataContext="{Binding TotalLimitBox}" Width="45" Style="{StaticResource LimitBox}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
            </WrapPanel>

            <ItemsControl ItemsSource="{Binding LimitChips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,4"
                                BorderBrush="{Binding Status, Converter={StaticResource StatusBrush}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center"
                                         Fill="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                <TextBlock Text="{Binding Text}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding PlotHint}" Foreground="{StaticResource Brush.TextMuted}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlotHint}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding TableStatusText}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TableStatusText}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LimitsUnsaved}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Built in code: the columns depend on the codes in use, and the headers merge across them.
             The floor columns stay put while the usage columns scroll sideways. -->
        <ScrollViewer Margin="8,0,8,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                    FlowDirection="RightToLeft" x:Name="TableFrame">
                <Grid x:Name="TableHost" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="FixedPart" Grid.Column="0"/>
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid x:Name="CodesPart" HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </ScrollViewer>
    </DockPanel>
</UserControl>
