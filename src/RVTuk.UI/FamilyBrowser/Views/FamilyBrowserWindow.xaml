<Window x:Class="RVTuk.UI.FamilyBrowser.Views.FamilyBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RVTuk.UI.FamilyBrowser.ViewModels"
        xmlns:ctrl="clr-namespace:RVTuk.UI.Shared.Controls"
        Title="RVTuk — Family Browser"
        Width="900" Height="620" MinWidth="660" MinHeight="420"
        Topmost="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RVTuk.UI;component/Shared/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Background><StaticResource ResourceKey="Brush.Bg"/></Window.Background>
    <Window.Foreground><StaticResource ResourceKey="Brush.Text"/></Window.Foreground>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="200"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── LEFT PANEL ─────────────────────────────────────────────── -->
        <Grid Grid.Column="0" Background="{StaticResource Brush.Panel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- LINE 1: Category (checkbox popover) + source toggles -->
            <Grid Grid.Row="0" Margin="6,6,6,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,4,0">
                    <ToggleButton x:Name="CategoryToggle" HorizontalContentAlignment="Left"
                                  Content="{Binding CategorySummary}"
                                  ToolTip="Filter by category (tick several)"/>
                    <Popup StaysOpen="False" AllowsTransparency="True" Placement="Bottom"
                           PlacementTarget="{Binding ElementName=CategoryToggle}"
                           IsOpen="{Binding IsChecked, ElementName=CategoryToggle, Mode=TwoWay}">
                        <Border Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1" Padding="6" MinWidth="180"
                                TextElement.Foreground="{StaticResource Brush.Text}">
                            <StackPanel>
                                <CheckBox Content="All categories" FontWeight="SemiBold" Margin="2" IsThreeState="True"
                                          IsChecked="{Binding IsAllCategoriesSelected, Mode=OneWay}"
                                          Click="AllCategoriesCheckBox_Click"/>
                                <Separator/>
                                <ItemsControl ItemsSource="{Binding CategoryOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" Margin="2"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Source toggles: in the model (⬅), favourites (⭐), in the library (⬅ mirrored
                     as ➡) — all off by default (unfiltered). Each pressed toggle narrows the
                     list (AND); ⬅ and ➡ are inclusive, so pressing both shows only the families
                     that exist in both the model and the library (Core's SourceToggleFilter). -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- ⬅️/➡️ used to be two different emoji code points (U+2B05 / U+27A1),
                         which don't render as a true mirror pair in every font. One Path,
                         flipped via RenderTransform, guarantees they match. -->
                    <ToggleButton Width="30" Height="28" Margin="0,0,2,0"
                                  IsChecked="{Binding ShowInProjectFamilies, Mode=TwoWay}"
                                  ToolTip="Show families loaded in the model (press both arrows for families in the model and the library)">
                        <Viewbox Width="14" Height="14" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <ScaleTransform ScaleX="-1"/>
                            </Viewbox.RenderTransform>
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{StaticResource Brush.Text}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M4,12 L20,12 M14,6 L20,12 L14,18"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>
                    <ToggleButton Width="30" Height="28" Margin="0,0,2,0" FontSize="13"
                                  IsChecked="{Binding ShowFavoriteFamilies, Mode=TwoWay}"
                                  ToolTip="Show favourite families"
                                  Content="⭐"/>
                    <ToggleButton Width="30" Height="28"
                                  IsChecked="{Binding ShowLibraryFamilies, Mode=TwoWay}"
                                  ToolTip="Show families in the library (press both arrows for families in the model and the library)">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{StaticResource Brush.Text}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M4,12 L20,12 M14,6 L20,12 L14,18"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <!-- LINE 2: Search + Refresh -->
            <Grid Grid.Row="1" Margin="6,0,6,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="100"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search box with overlay hint text (VisualBrush avoided — render-thread-unsafe in WPF 4.x)
                     and a clear (✕) button shown only while there's text to clear. -->
                <Grid Grid.Column="0" Margin="0,0,4,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="4,2,22,2"/>
                    <TextBlock Text="&#x1F50D; Search..." IsHitTestVisible="False"
                               Foreground="{StaticResource Brush.TextMuted}"
                               Margin="7,0,0,0" VerticalAlignment="Center" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                             Width="18" Height="18" Margin="0,0,2,0" Padding="0"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource Brush.TextMuted}" FontSize="9"
                             Command="{Binding ClearSearchCommand}"
                             ToolTip="Clear search"
                             Content="&#x2715;">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Button Grid.Column="1" Width="30" Height="28" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding SyncCommand}"
                        ToolTip="Re-check which families are in the active project and which are outdated">
                    <Viewbox Width="13" Height="13">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{StaticResource Brush.Text}"
                                  Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <!-- Update All bar (visible only when outdated families exist) -->
            <Button Grid.Row="2" Margin="6,0,6,4"
                    Command="{Binding UpdateAllCommand}"
                    Visibility="{Binding ShowUpdateAll, Converter={StaticResource BoolVis}}"
                    Content="{Binding OutdatedCount, StringFormat='&#x2191; Update All ({0})'}"
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource Brush.AccentDark}"/>

            <!-- Family list (compact rows) — hidden while the grid view is active -->
            <ListBox Grid.Row="3"
                     ItemsSource="{Binding FilteredItems}"
                     SelectedItem="{Binding SelectedItem}"
                     AlternationCount="2"
                     BorderThickness="0,1,0,0">
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <!-- Zero padding + zebra background so rows sit flush yet stay separable. -->
                        <Setter Property="Padding" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FamilyBrowserItemViewModel}">
                        <Grid Margin="6,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="48" Height="48" Stretch="Uniform"/>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <!-- Two lines max, then ellipsis; the tooltip carries the full name. -->
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32"
                                           ToolTip="{Binding DisplayName}"/>
                                <TextBlock Text="{Binding Category}"
                                           Foreground="{StaticResource Brush.TextMuted}" FontSize="10"/>
                            </StackPanel>
                            <!-- Red version = _Version is an instance parameter (off-standard;
                                 the family needs it changed to a type parameter). -->
                            <TextBlock Grid.Column="2" Text="{Binding Version}" FontSize="10"
                                       VerticalAlignment="Center" Margin="4,0,0,0"
                                       Visibility="{Binding HasVersion, Converter={StaticResource BoolVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                        <Setter Property="ToolTip" Value="Family version (_Version parameter)"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VersionIsInstance}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
                                                <Setter Property="ToolTip" Value="_Version is an instance parameter — change it to a type parameter (office standard)"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="3" Text="&#x2713;" Foreground="{StaticResource Brush.Success}"
                                       VerticalAlignment="Center" Margin="4,0,2,0"
                                       Visibility="{Binding ShowUpToDate, Converter={StaticResource BoolVis}}"/>
                            <Border Grid.Column="3" Background="{StaticResource Brush.Accent}" CornerRadius="3"
                                    Padding="4,1" Margin="4,0,2,0"
                                    Visibility="{Binding ShowUpdateAvailable, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="&#x2191; Update" Foreground="White" FontSize="10"/>
                            </Border>
                            <TextBlock Grid.Column="3" Text="&#x26A0;&#xFE0F;" FontSize="12"
                                       VerticalAlignment="Center" Margin="4,0,2,0"
                                       ToolTip="Loaded in the project but not found in the library"
                                       Visibility="{Binding IsModelOnly, Converter={StaticResource BoolVis}}"/>
                            <Button Grid.Column="4" Margin="2,0,0,0" Padding="3,0" BorderThickness="0"
                                    Background="Transparent" ToolTip="Toggle favourite"
                                    Command="{Binding DataContext.ToggleFavoriteCommand,
                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <!-- No DB row behind a model-only family: no favourite to toggle. -->
                                            <DataTrigger Binding="{Binding IsModelOnly}" Value="True">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#x2606;"/>
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Text" Value="&#x2605;"/>
                                                    <Setter Property="Foreground" Value="Gold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Family list (2-column large-thumbnail cards) — same ItemsSource/SelectedItem as the
                 row list above, so selection + keyboard navigation carry across the toggle. Shown
                 only while the grid view is active. UniformGrid Columns="2" forces exactly two
                 columns regardless of item count. -->
            <ListBox Grid.Row="3"
                     ItemsSource="{Binding FilteredItems}"
                     SelectedItem="{Binding SelectedItem}"
                     BorderThickness="0,1,0,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Visibility="{Binding IsGridView, Converter={StaticResource BoolVis}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FamilyBrowserItemViewModel}">
                        <Border Margin="4" Height="160"
                                Background="{StaticResource Brush.Control}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                            <Grid>
                                <!-- Large thumbnail filling the card -->
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="6"/>

                                <!-- Name floating on a dark scrim across the bottom -->
                                <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="5,3">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{StaticResource Brush.Text}"
                                               FontWeight="SemiBold" FontSize="11"
                                               TextWrapping="Wrap" MaxHeight="32"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>

                                <!-- Status flags floating at the top-right -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Top" Margin="4">
                                    <!-- Red version = _Version is an instance parameter (see the
                                         matching row-list note). -->
                                    <Border Background="#66000000" CornerRadius="3" Padding="4,1" Margin="0,0,2,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasVersion, Converter={StaticResource BoolVis}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="ToolTip" Value="Family version (_Version parameter)"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VersionIsInstance}" Value="True">
                                                        <Setter Property="ToolTip" Value="_Version is an instance parameter — change it to a type parameter (office standard)"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Version}" FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding VersionIsInstance}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="&#x2713;" Foreground="{StaticResource Brush.Success}"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,2,0"
                                               Visibility="{Binding ShowUpToDate, Converter={StaticResource BoolVis}}"/>
                                    <Border Background="{StaticResource Brush.Accent}" CornerRadius="3"
                                            Padding="4,1" Margin="0,0,2,0" VerticalAlignment="Center"
                                            Visibility="{Binding ShowUpdateAvailable, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="&#x2191; Update" Foreground="White" FontSize="10"/>
                                    </Border>
                                    <Border Background="#66000000" CornerRadius="3" Padding="4,1" Margin="0,0,2,0"
                                            VerticalAlignment="Center"
                                            ToolTip="Loaded in the project but not found in the library"
                                            Visibility="{Binding IsModelOnly, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="&#x26A0;&#xFE0F;" FontSize="11"/>
                                    </Border>
                                    <Button Padding="3,0" BorderThickness="0"
                                            Background="#66000000" ToolTip="Toggle favourite"
                                            Command="{Binding DataContext.ToggleFavoriteCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <!-- No DB row behind a model-only family: no favourite to toggle. -->
                                                    <DataTrigger Binding="{Binding IsModelOnly}" Value="True">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#x2606;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Text" Value="&#x2605;"/>
                                                            <Setter Property="Foreground" Value="Gold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Rail footer: help/about (left) · grid-view toggle + settings (right) -->
            <Grid Grid.Row="4" Margin="6" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Width="30" Height="28" Padding="0" FontSize="13"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding ToggleHelpCommand}"
                        ToolTip="Help, info &amp; support"
                        Content="ℹ️"/>
                <!-- Grid-view toggle (2x2 squares). Hand-drawn vector to match the other icon-only
                     buttons in this window rather than an emoji. -->
                <ToggleButton Grid.Column="2" Width="30" Height="28" Padding="0" Margin="0,0,4,0"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              IsChecked="{Binding IsGridView, Mode=TwoWay}"
                              ToolTip="Toggle grid view">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="3"  Canvas.Top="3"  Width="8" Height="8" RadiusX="1.5" RadiusY="1.5"
                                       Stroke="{StaticResource Brush.Text}" StrokeThickness="2"/>
                            <Rectangle Canvas.Left="13" Canvas.Top="3"  Width="8" Height="8" RadiusX="1.5" RadiusY="1.5"
                                       Stroke="{StaticResource Brush.Text}" StrokeThickness="2"/>
                            <Rectangle Canvas.Left="3"  Canvas.Top="13" Width="8" Height="8" RadiusX="1.5" RadiusY="1.5"
                                       Stroke="{StaticResource Brush.Text}" StrokeThickness="2"/>
                            <Rectangle Canvas.Left="13" Canvas.Top="13" Width="8" Height="8" RadiusX="1.5" RadiusY="1.5"
                                       Stroke="{StaticResource Brush.Text}" StrokeThickness="2"/>
                        </Canvas>
                    </Viewbox>
                </ToggleButton>
                <ToggleButton Grid.Column="3" Width="30" Height="28" Padding="0" FontSize="13"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              IsChecked="{Binding IsShowingSettings, Mode=OneWay}"
                              Command="{Binding ToggleSettingsCommand}"
                              ToolTip="Settings"
                              Content="⚙️"/>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

        <!-- ── RIGHT PANEL ─────────────────────────────────────────────── -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- FAMILY DETAIL (default view) -->
            <Grid Grid.Row="0" Grid.RowSpan="2"
                  Visibility="{Binding ShowDetailPane, Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,10,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="118"/>
                        <ColumnDefinition Width="Auto" MaxWidth="280"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="118" Height="118" VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            Background="{StaticResource Brush.Control}"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                        <Image Source="{Binding SelectedItem.Thumbnail}" Stretch="Uniform" Margin="3"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="10,0,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Margin="0,0,6,0" Padding="2,0" BorderThickness="0"
                                    Background="Transparent" ToolTip="Toggle favourite"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    CommandParameter="{Binding SelectedItem}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <!-- No DB row behind a model-only family: no favourite to toggle. -->
                                            <DataTrigger Binding="{Binding SelectedItem.IsModelOnly}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontSize="16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#x2606;"/>
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem.IsFavorite}" Value="True">
                                                    <Setter Property="Text" Value="&#x2605;"/>
                                                    <Setter Property="Foreground" Value="Gold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <TextBlock Text="{Binding SelectedItem.DisplayName}" FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Text="{Binding SelectedItem.Category}"
                                   Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                        <TextBlock Text="&#x26A0;&#xFE0F; Loaded in the project but not found in the library"
                                   Foreground="{StaticResource Brush.TextMuted}" FontSize="11"
                                   FontStyle="Italic" Margin="0,2,0,0"
                                   Visibility="{Binding SelectedItem.IsModelOnly,
                                                Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="{Binding ShowTags, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="&#x1F3F7;" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"
                                       Foreground="{StaticResource Brush.Accent}"/>
                            <ItemsControl ItemsSource="{Binding SelectedTagChips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Margin="0,0,4,4" Padding="6,1" FontSize="11"
                                                Command="{Binding DataContext.FilterByTagCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Filter the list by this tag"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- Load / Update — one button, vertically centred against the thumbnail's
                         height; switches to "Update" + orange when a newer version exists. -->
                    <Button Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0"
                            Padding="16,7" FontWeight="SemiBold" Content="Load"
                            Command="{Binding LoadFamilyCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowUpdateInProject}" Value="True">
                                        <Setter Property="Content" Value="Update"/>
                                        <Setter Property="Command" Value="{Binding UpdateInProjectCommand}"/>
                                        <Setter Property="Background" Value="{StaticResource Brush.UpdateOrange}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.UpdateOrange}"/>
                                    </DataTrigger>
                                    <!-- A model-only family has no .rfa to load from — a permanently
                                         disabled button would just look broken, so hide it. -->
                                    <DataTrigger Binding="{Binding SelectedItem.IsModelOnly}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Save to Library — the model-only counterpart of Load: writes the family
                         from the model into the library folder so the library can be grown from
                         the project. -->
                    <Button Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0"
                            Padding="16,7" FontWeight="SemiBold" Content="Save to Library"
                            Command="{Binding SaveToLibraryCommand}"
                            ToolTip="Save this family from the model into the library folder"
                            Visibility="{Binding SelectedItem.IsModelOnly, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>

                    <!-- Rescan / Edit Info / Open — top-right corner of the panel, stacked -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Top">
                        <Button Width="30" Height="28" Margin="0,0,0,4" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding RescanFamilyCommand}"
                                ToolTip="Re-read this family's parameters and thumbnail from disk">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <!-- No .rfa / DB row behind a model-only family: nothing to rescan. -->
                                        <DataTrigger Binding="{Binding SelectedItem.IsModelOnly}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="13" Height="13">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{StaticResource Brush.Text}"
                                          Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Width="30" Height="28" Margin="0,0,0,4" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding EditInfoCommand}"
                                ToolTip="Edit Info">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <!-- No DB row behind a model-only family: no info to edit. -->
                                        <DataTrigger Binding="{Binding SelectedItem.IsModelOnly}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="13" Height="13">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="4" Canvas.Top="3" Width="13" Height="18"
                                               Stroke="{StaticResource Brush.Text}" StrokeThickness="1.6"/>
                                    <Path Stroke="{StaticResource Brush.Text}" StrokeThickness="1.6"
                                          Data="M7.5 8 L13.5 8 M7.5 12 L11 12"/>
                                    <Path Fill="{StaticResource Brush.Text}"
                                          Data="M14.5 16.5 L19.5 11.5 L21.7 13.7 L16.7 18.7 L14.5 18.7 Z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Width="30" Height="28" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding OpenFamilyEditorCommand}"
                                ToolTip="Open in Family Editor (model-only families open from the model)">
                            <Viewbox Width="13" Height="13">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{StaticResource Brush.Text}" StrokeThickness="1.6"
                                          Data="M10 4 L5 4 L5 20 L19 20 L19 15"/>
                                    <Path Stroke="{StaticResource Brush.Text}" StrokeThickness="1.6"
                                          Data="M14 4 L20 4 L20 10 M20 4 L11 13"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <TabControl Grid.Row="1" Margin="12,0,12,10">
                    <TabItem Header="Instructions">
                        <RichTextBox IsReadOnly="True"
                                     ctrl:RichTextBoxHelper.DocumentXaml="{Binding InstructionsXaml}"/>
                    </TabItem>
                    <TabItem Header="{Binding FilteredParameters.Count, StringFormat='Parameters ({0})'}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" Margin="0,0,0,4"
                                     Text="{Binding ParameterFilter, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Filter parameters by name, group, or kind"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredParameters}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name"  Binding="{Binding ParameterName}" Width="*"/>
                                    <DataGridTextColumn Header="Group" Binding="{Binding ParamGroup}"    Width="130"/>
                                    <DataGridTemplateColumn Header="Kind" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="1" CornerRadius="8" Padding="6,1"
                                                        HorizontalAlignment="Left" Background="Transparent">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Shared">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="System">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Success}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Kind}" FontSize="9.5" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Shared">
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="System">
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Success}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Type"  Binding="{Binding DataType}"      Width="100"/>
                                    <DataGridCheckBoxColumn Header="Inst." Binding="{Binding IsInstance}" Width="46"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- SETTINGS (embedded — replaces the old ribbon Config window) -->
            <ScrollViewer Grid.Row="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsShowingSettings, Converter={StaticResource BoolVis}}">
                <StackPanel Margin="22,20,22,22" MaxWidth="480" HorizontalAlignment="Left"
                            DataContext="{Binding Settings}">
                    <TextBlock Text="Settings" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="Family Library" Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="11" Margin="0,2,0,20"/>

                    <TextBlock Text="LIBRARY ROOT FOLDER"
                               Foreground="{StaticResource Brush.TextMuted}" FontSize="10"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" IsReadOnly="True" Margin="0,0,6,0"
                                 Text="{Binding LibraryFolderPath, Mode=OneWay}"
                                 Foreground="{StaticResource Brush.TextMuted}"/>
                        <Button Grid.Column="1" Content="Browse…" Width="72"
                                Command="{Binding BrowseLibraryCommand}"/>
                    </Grid>
                    <TextBlock Foreground="{StaticResource Brush.TextMuted}" FontSize="10"
                               Margin="0,5,0,0" TextWrapping="Wrap">
                        The .DB folder with the database will be created here automatically.
                    </TextBlock>

                    <Separator Margin="0,26,0,22"/>

                    <TextBlock Text="SCAN" Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"
                               Foreground="{StaticResource Brush.Text}">
                        Scan always adds new families and removes ones whose files are gone.
                        Check a box to also refresh that data for anything new, changed, or
                        currently missing it — nothing else is touched.
                        <LineBreak/><LineBreak/>
                        <Run FontWeight="SemiBold">Update thumbnails</Run> re-reads each family's
                        preview image — a fast, plain file read.
                        <LineBreak/>
                        <Run FontWeight="SemiBold">Update parameters</Run> re-reads category and
                        parameters using the Revit engine — slower.
                        <LineBreak/><LineBreak/>
                        Your instructions, pictures, custom thumbnails, tags, and favourites are
                        always kept.
                    </TextBlock>
                    <CheckBox Content="Update thumbnails" Margin="0,0,0,8"
                              IsChecked="{Binding ScanThumbnails}"/>
                    <CheckBox Content="Update parameters (slower)" Margin="0,0,0,14"
                              IsChecked="{Binding ScanParameters}"/>
                    <Button Command="{Binding ScanCommand}"
                            HorizontalAlignment="Left"
                            Padding="14,7" Background="{StaticResource Brush.AccentDark}"
                            BorderBrush="{StaticResource Brush.Accent}"
                            Content="Scan"/>

                    <Separator Margin="0,26,0,22"/>

                    <TextBlock Text="IGNORED SUBFOLDERS" Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox AcceptsReturn="True" Height="80"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding IgnoredSubfoldersText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Foreground="{StaticResource Brush.TextMuted}" FontSize="10"
                               Margin="0,5,0,0" TextWrapping="Wrap">
                        One subfolder per line, relative to the library root. Families under these
                        folders are skipped by scans and hidden in the browser; their existing data
                        is kept.
                    </TextBlock>

                    <TextBlock Text="IGNORED FILES (REGEX)" Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="10" FontWeight="SemiBold" Margin="0,18,0,8"/>
                    <TextBox AcceptsReturn="True" Height="60"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             Text="{Binding IgnoredFilePatternsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Foreground="{StaticResource Brush.TextMuted}" FontSize="10"
                               Margin="0,5,0,0" TextWrapping="Wrap">
                        One regular expression per line, matched against the file name. Matching
                        families are skipped by scans and hidden in the browser; their existing
                        data is kept. The default pattern .*\.\d{4}\.rfa hides Revit backup files
                        (e.g. Door.0001.rfa). Invalid expressions are ignored.
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <!-- HELP / ABOUT (markdown, fetched from the docs repo) -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Margin="16"
                  Visibility="{Binding IsShowingHelp, Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding HelpSourceLabel}"
                           Foreground="{StaticResource Brush.TextDisabled}" FontSize="10"
                           Margin="0,0,0,10" TextWrapping="Wrap"/>
                <RichTextBox Grid.Row="1" IsReadOnly="True" BorderThickness="0"
                             VerticalScrollBarVisibility="Auto"
                             ctrl:RichTextBoxHelper.MarkdownSource="{Binding HelpMarkdownRaw}"/>
            </Grid>
        </Grid>

    </Grid>
</Window>
