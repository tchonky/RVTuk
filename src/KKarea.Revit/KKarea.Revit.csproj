<Project Sdk="Microsoft.NET.Sdk">

  <!-- KKarea: standalone host for the Area Calc (Rishui Zamin) tool on Revit 2023 (net48),
       the one year RVTuk does not ship for; 2024-2027 get the full RVTuk add-in. It is built
       only via the Release2023 configuration (see RVTuk.sln mappings). The
       area logic is linked shared source from RVTuk.Revit, compiled here against each year's
       API, with the REVIT2023 constant switching the 2023 ElementId shims. -->
  <PropertyGroup>
    <AssemblyName>KKarea.Revit</AssemblyName>
    <RootNamespace>KKarea.Revit</RootNamespace>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- .NET (Core) libraries don't copy NuGet deps to bin by default. Revit.exe loads the
       add-in, so it must carry its own dependency closure — including
       runtimes\win-x64\native\e_sqlite3.dll — for Copy-AddInOutput (build\Staging.ps1) to pick up. net48 already does. -->
  <PropertyGroup Condition="'$(TargetFramework)'!='net48'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Revit API packages for the configured year: compile-time only, the real DLLs come
       from the Revit install. -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI"
                      Version="$(RevitYear).*"
                      IncludeAssets="compile;build;native;contentfiles;analyzers;buildtransitive"
                      ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI"
                      Version="$(RevitYear).*"
                      IncludeAssets="compile;build;native;contentfiles;analyzers;buildtransitive"
                      ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RVTuk.Core\RVTuk.Core.csproj" />
    <ProjectReference Include="..\RVTuk.UI\RVTuk.UI.csproj" />
  </ItemGroup>

  <!-- Shared source linked from RVTuk.Revit — single-source area logic, compiled per host
       against each host's Revit API version. KKarea must never reference RVTuk.Revit itself. -->
  <ItemGroup>
    <Compile Include="..\RVTuk.Revit\RishuiZamin\AreaExtractor.cs" Link="Shared\AreaExtractor.cs" />
    <Compile Include="..\RVTuk.Revit\RishuiZamin\UsageKeyScheduleBuilder.cs" Link="Shared\UsageKeyScheduleBuilder.cs" />
    <Compile Include="..\RVTuk.Revit\RishuiZamin\ExternalEvents\AreaExtractEventHandler.cs" Link="Shared\AreaExtractEventHandler.cs" />
    <Compile Include="..\RVTuk.Revit\RishuiZamin\ExternalEvents\SelectAreaEventHandler.cs" Link="Shared\SelectAreaEventHandler.cs" />
    <Compile Include="..\RVTuk.Revit\RishuiZamin\ExternalEvents\SetupUsageKeysEventHandler.cs" Link="Shared\SetupUsageKeysEventHandler.cs" />
  </ItemGroup>

</Project>
