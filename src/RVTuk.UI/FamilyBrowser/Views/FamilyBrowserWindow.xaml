<Window x:Class="RVTuk.UI.FamilyBrowser.Views.FamilyBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:RVTuk.UI.Shared.Themes"
        xmlns:vm="clr-namespace:RVTuk.UI.FamilyBrowser.ViewModels"
        xmlns:ctrl="clr-namespace:RVTuk.UI.Shared.Controls"
        xmlns:v="clr-namespace:RVTuk.UI.FamilyBrowser.Views"
        Title="RVTuk — Family Browser"
        Width="900" Height="620" MinWidth="660" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        PreviewMouseDown="Window_PreviewMouseDown"
        LocationChanged="Window_MovedOrDeactivated" Deactivated="Window_MovedOrDeactivated">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:DarkThemeDictionary/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
            <v:CategoryIconConverter x:Key="CategoryIcon"/>
            <v:TablerIconConverter x:Key="IconByName"/>

            <!-- One request in the Requests list. The text is another user's: plain text only. -->
            <DataTemplate x:Key="RequestCard" DataType="{x:Type vm:RequestItemViewModel}">
                <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="2"
                        Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="18" Height="18" Margin="0,1,10,0" VerticalAlignment="Top">
                            <Canvas Width="24" Height="24">
                                <Path Data="{Binding IconName, Converter={StaticResource IconByName}}"
                                      Stroke="{StaticResource Brush.Text}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <StackPanel Grid.Column="1">
                            <!-- A fix's family name links to the family; a new-family request has none. -->
                            <TextBlock FontWeight="SemiBold" Visibility="{Binding IsFix, Converter={StaticResource BoolVis}}">
                                <Hyperlink Command="{Binding DataContext.ShowRequestFamilyCommand,
                                                     RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                           CommandParameter="{Binding}" Foreground="{StaticResource Brush.Accent}"
                                           ToolTip="Show this family">
                                    <Run Text="{Binding Title, Mode=OneWay}"/>
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       Visibility="{Binding HasPlainTitle, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="{Binding Meta}" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" Margin="0,1,0,2"/>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FlowDirection="{Binding TextFlowDirection}"
                                       Visibility="{Binding HasText, Converter={StaticResource BoolVis}}"/>
                            <TextBlock FontSize="10" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0"
                                       Text="&#x1F4CE; Their project's version is attached"
                                       Visibility="{Binding ShowAttachmentNote, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                            <!-- A suggested family: Approve files it in the library. -->
                            <Button Content="Approve" Padding="8,2" FontSize="11" Margin="0,0,4,0" FontWeight="SemiBold"
                                    ToolTip="Add this family to the library"
                                    Visibility="{Binding CanApprove, Converter={StaticResource BoolVis}}"
                                    Command="{Binding DataContext.ApproveSuggestionCommand,
                                              RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="{Binding DoneLabel}" Padding="8,2" FontSize="11" ToolTip="{Binding DoneToolTip}"
                                    Visibility="{Binding CanMarkDone, Converter={StaticResource BoolVis}}"
                                    Command="{Binding DataContext.MarkRequestDoneCommand,
                                              RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="Withdraw" Padding="8,2" FontSize="11" Margin="4,0,0,0"
                                    ToolTip="Take back your request"
                                    Visibility="{Binding CanWithdraw, Converter={StaticResource BoolVis}}"
                                    Command="{Binding DataContext.WithdrawRequestCommand,
                                              RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Background><StaticResource ResourceKey="Brush.Bg"/></Window.Background>
    <Window.Foreground><StaticResource ResourceKey="Brush.Text"/></Window.Foreground>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="200"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── LEFT PANEL ─────────────────────────────────────────────── -->
        <Grid Grid.Column="0" Background="{StaticResource Brush.Panel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- SEARCH ROW: one box for words, categories (OR) and tags (AND) · ⟳ · ⭐.
                 Ticked categories and chosen tags show as chips in the box; focusing it opens
                 the dropdown below. Rules: Core's FamilyFilter. -->
            <Grid Grid.Row="0" x:Name="SearchRow" Margin="6,6,6,4" SizeChanged="SearchRow_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="SearchArea" Grid.Column="0" Margin="0,0,4,0" MinHeight="28"
                        BorderThickness="1" CornerRadius="2" Cursor="IBeam"
                        Background="{StaticResource Brush.Input}"
                        MouseLeftButtonDown="SearchArea_MouseDown">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearchPopupOpen}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderFocus}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Viewbox Width="14" Height="14" Margin="6,6,0,0" HorizontalAlignment="Left"
                                 VerticalAlignment="Top" IsHitTestVisible="False">
                            <Canvas Width="24" Height="24">
                                <Path Data="{v:Icon search}" Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <!-- Hint over the empty box (VisualBrush avoided — render-thread-unsafe in WPF 4.x). -->
                        <TextBlock Text="{Binding SearchHint}" Margin="26,0,22,0" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{StaticResource Brush.TextMuted}"
                                   TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                        <WrapPanel Margin="24,2,22,2" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding FilterChips}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FilterChip}">
                                        <Border Margin="0,1,3,1" Height="20" CornerRadius="10" BorderThickness="1"
                                                Padding="6,0,1,0" ToolTip="{Binding ToolTip}" Cursor="Arrow">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Brush.Control}"/>
                                                    <Setter Property="BorderBrush" Value="#5A5A5A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                                            <Setter Property="Background" Value="#2D3A48"/>
                                                            <Setter Property="BorderBrush" Value="#4A6A8A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource Brush.Selection}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="12" Height="12" Margin="0,0,3,0" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="{Binding IconName, Converter={StaticResource IconByName}}"
                                                              Stroke="{StaticResource Brush.Text}" StrokeThickness="2"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Text="{Binding Value}" FontSize="11" VerticalAlignment="Center"
                                                           MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                                                <Button Focusable="False" Width="16" Height="16" Margin="2,0,0,0" Padding="0"
                                                        BorderThickness="0" Background="Transparent" Cursor="Hand"
                                                        ToolTip="{Binding RemoveLabel}"
                                                        AutomationProperties.Name="{Binding RemoveLabel}"
                                                        Command="{Binding DataContext.RemoveChipCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Click="RefocusSearch">
                                                    <Viewbox Width="9" Height="9">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="{v:Icon x}" Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="2.5"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox x:Name="SearchBox" MinWidth="90" Height="22" Padding="2,0"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="Search families, categories and tags"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                                     PreviewMouseDown="SearchBox_PreviewMouseDown"
                                     PreviewKeyDown="SearchBox_PreviewKeyDown"
                                     LostKeyboardFocus="SearchBox_LostKeyboardFocus"
                                     TextChanged="SearchBox_TextChanged"/>
                        </WrapPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,2,0"
                                Width="18" Height="18" Padding="0" Cursor="Hand"
                                BorderThickness="0" Background="Transparent"
                                Command="{Binding ClearSearchCommand}"
                                ToolTip="Clear the search, categories and tags"
                                Visibility="{Binding HasAnyFilter, Converter={StaticResource BoolVis}}">
                            <Viewbox Width="10" Height="10">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{v:Icon x}" Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="2.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <Button Grid.Column="1" Width="30" Height="28" Padding="0" Margin="0,0,2,0" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding SyncCommand}"
                        ToolTip="{Binding SyncToolTip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsComparisonHidden}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.AccentDark}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{StaticResource Brush.Text}"
                                  Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <ToggleButton Grid.Column="2" Width="30" Height="28" FontSize="17" Padding="0" VerticalAlignment="Top"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              IsChecked="{Binding ShowFavoriteFamilies, Mode=TwoWay}"
                              ToolTip="Show favourite families"
                              Content="⭐"/>

                <!-- The dropdown: tags (AND) then categories (OR). It stays open on its own; code-behind
                     closes it on a click elsewhere, Tab, Esc, or the window moving. -->
                <Popup x:Name="SearchPopup" StaysOpen="True" AllowsTransparency="True" Placement="Bottom"
                       PlacementTarget="{Binding ElementName=SearchRow}"
                       Width="{Binding ActualWidth, ElementName=SearchRow}"
                       IsOpen="{Binding IsSearchPopupOpen, Mode=TwoWay}"
                       PreviewKeyDown="SearchPopup_PreviewKeyDown">
                    <Border x:Name="SearchPopupContent" Margin="0,2,0,0" Padding="6"
                            Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" TextElement.Foreground="{StaticResource Brush.Text}">
                        <!-- A Popup taller than the screen can't scroll: cap it. -->
                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel>
                                <StackPanel Visibility="{Binding ShowTagSuggestions, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="TAGS · every tag must match" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.TextMuted}" Margin="2,2,2,4"/>
                                    <ItemsControl ItemsSource="{Binding TagSuggestions}" Margin="0,0,0,6">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TagSuggestion}">
                                                <Button Focusable="False" Margin="2" Padding="8,2" IsEnabled="{Binding IsEnabled}"
                                                        ToolTip="{Binding ToolTip}" ToolTipService.ShowOnDisabled="True"
                                                        Command="{Binding DataContext.FilterByTagCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Name}" Click="RefocusSearch">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource Brush.Selection}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Viewbox Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                 Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolVis}}">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="{v:Icon lock}" Stroke="{StaticResource Brush.Text}" StrokeThickness="2"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                        <TextBlock Text="{Binding Name}" FontSize="11"/>
                                                        <TextBlock Text="{Binding Count}" FontSize="11" Margin="5,0,0,0"
                                                                   Foreground="{StaticResource Brush.TextMuted}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Separator Margin="0,0,0,4"/>
                                </StackPanel>

                                <DockPanel Margin="2,2,2,3">
                                    <Button Focusable="False" DockPanel.Dock="Right" Content="Clear" Padding="2,0" FontSize="11"
                                            BorderThickness="0" Background="Transparent" Cursor="Hand"
                                            Foreground="{StaticResource Brush.Accent}"
                                            Command="{Binding ClearCategoriesCommand}"
                                            ToolTip="Untick every category"
                                            Visibility="{Binding HasSelectedCategories, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="CATEGORIES · any ticked one" FontSize="10" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding VisibleCategoryOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CategoryFilterOption}">
                                            <CheckBox Focusable="False" Margin="2" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      HorizontalContentAlignment="Stretch">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="{Binding IconCategory, Converter={StaticResource CategoryIcon}}"
                                                                  Stroke="{StaticResource Brush.Text}" StrokeThickness="2"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{StaticResource Brush.TextMuted}"/>
                                                </Grid>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="2,4" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Text="No category or tag matches. The words still search the family names."
                                           Visibility="{Binding ShowNoSearchMatch, Converter={StaticResource BoolVis}}"/>
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
                                        Margin="0,6,0,0" Padding="2,5,2,0">
                                    <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}"
                                               Text="Enter adds the first tag · Backspace removes the last chip · Esc closes"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>

            <!-- Another document is active: the comparison is hidden until ⟳ (or coming back). -->
            <TextBlock Grid.Row="2" Margin="8,0,6,4" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.Accent}"
                       Text="Another project is active — press ⟳ to compare."
                       Visibility="{Binding IsComparisonHidden, Converter={StaticResource BoolVis}}"/>

            <!-- Update All bar (visible only when outdated families exist) -->
            <Button Grid.Row="2" Margin="6,0,6,4"
                    Command="{Binding UpdateAllCommand}"
                    Visibility="{Binding ShowUpdateAll, Converter={StaticResource BoolVis}}"
                    Content="{Binding OutdatedCount, StringFormat='&#x2191; Update All ({0})'}"
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource Brush.AccentDark}"/>

            <!-- Family list (compact rows) — hidden while the grid view is active -->
            <ListBox Grid.Row="3"
                     ItemsSource="{Binding FilteredItems}"
                     SelectedItem="{Binding SelectedItem}"
                     AlternationCount="2"
                     BorderThickness="0,1,0,0">
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <!-- Zero padding + zebra background so rows sit flush yet stay separable. -->
                        <Setter Property="Padding" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FamilyBrowserItemViewModel}">
                        <Grid Margin="6,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="48" Height="48" Stretch="Uniform"/>
                            <!-- An open fix request (the "Fix requested" tag). -->
                            <Viewbox Grid.Column="4" Width="15" Height="15" Margin="4,0,0,0" VerticalAlignment="Center"
                                     ToolTip="A fix is requested for this family"
                                     Visibility="{Binding IsFixRequested, Converter={StaticResource BoolVis}}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{v:Icon tool}" Stroke="{StaticResource Brush.UpdateOrange}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <!-- Two lines max, then ellipsis; the tooltip carries the full name. -->
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32"
                                           ToolTip="{Binding DisplayName}"/>
                                <TextBlock Text="{Binding Category}"
                                           Foreground="{StaticResource Brush.TextMuted}" FontSize="10"/>
                            </StackPanel>
                            <!-- Red version = _Version is an instance parameter (off-standard;
                                 the family needs it changed to a type parameter). -->
                            <TextBlock Grid.Column="2" Text="{Binding Version}" FontSize="10"
                                       VerticalAlignment="Center" Margin="4,0,0,0"
                                       Visibility="{Binding HasVersion, Converter={StaticResource BoolVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                        <Setter Property="ToolTip" Value="Family version (_Version parameter)"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VersionIsInstance}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
                                                <Setter Property="ToolTip" Value="_Version is an instance parameter — change it to a type parameter (office standard)"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="3" Text="&#x2713;" Foreground="{StaticResource Brush.Success}"
                                       VerticalAlignment="Center" Margin="4,0,2,0"
                                       Visibility="{Binding ShowUpToDate, Converter={StaticResource BoolVis}}"/>
                            <!-- In the project, but nothing says whether it matches the library. -->
                            <TextBlock Grid.Column="3" Text="?" FontWeight="Bold" Foreground="{StaticResource Brush.TextMuted}"
                                       VerticalAlignment="Center" Margin="4,0,2,0"
                                       ToolTip="{x:Static vm:FamilyBrowserItemViewModel.UnknownToolTip}"
                                       Visibility="{Binding ShowUnknown, Converter={StaticResource BoolVis}}"/>
                            <Border Grid.Column="3" Background="{StaticResource Brush.Accent}" CornerRadius="3"
                                    Padding="4,1" Margin="4,0,2,0"
                                    Visibility="{Binding ShowUpdateAvailable, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="&#x2191; Update" Foreground="White" FontSize="10"/>
                            </Border>
                            <TextBlock Grid.Column="3" Text="&#x26A0;&#xFE0F;" FontSize="12"
                                       VerticalAlignment="Center" Margin="4,0,2,0"
                                       ToolTip="Loaded in the project but not found in the library"
                                       Visibility="{Binding IsModelOnly, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Grid.Column="3" Text="&#x26A0;&#xFE0F;" FontSize="12"
                                       VerticalAlignment="Center" Margin="4,0,2,0"
                                       ToolTip="{Binding DuplicateToolTip}"
                                       Visibility="{Binding ShowDuplicate, Converter={StaticResource BoolVis}}"/>
                            <Button Grid.Column="5" Margin="2,0,0,0" Padding="3,0" BorderThickness="0"
                                    Background="Transparent" ToolTip="Toggle favourite"
                                    Command="{Binding DataContext.ToggleFavoriteCommand,
                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <!-- No DB row behind a model-only family: no favourite to toggle. -->
                                            <DataTrigger Binding="{Binding IsModelOnly}" Value="True">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#x2606;"/>
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Text" Value="&#x2605;"/>
                                                    <Setter Property="Foreground" Value="Gold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Family list (2-column large-thumbnail cards) — same ItemsSource/SelectedItem as the
                 row list above, so selection + keyboard navigation carry across the toggle. Shown
                 only while the grid view is active. UniformGrid Columns="2" forces exactly two
                 columns regardless of item count. -->
            <ListBox Grid.Row="3"
                     ItemsSource="{Binding FilteredItems}"
                     SelectedItem="{Binding SelectedItem}"
                     BorderThickness="0,1,0,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Visibility="{Binding IsGridView, Converter={StaticResource BoolVis}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FamilyBrowserItemViewModel}">
                        <Border Margin="4" Height="160"
                                Background="{StaticResource Brush.Control}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                            <Grid>
                                <!-- Large thumbnail filling the card -->
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="6"/>

                                <!-- Name floating on a dark scrim across the bottom -->
                                <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="5,3">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{StaticResource Brush.Text}"
                                               FontWeight="SemiBold" FontSize="11"
                                               TextWrapping="Wrap" MaxHeight="32"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>

                                <!-- Status flags floating at the top-right -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Top" Margin="4">
                                    <!-- Red version = _Version is an instance parameter (see the
                                         matching row-list note). -->
                                    <Border Background="#66000000" CornerRadius="3" Padding="4,1" Margin="0,0,2,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasVersion, Converter={StaticResource BoolVis}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="ToolTip" Value="Family version (_Version parameter)"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VersionIsInstance}" Value="True">
                                                        <Setter Property="ToolTip" Value="_Version is an instance parameter — change it to a type parameter (office standard)"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Version}" FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding VersionIsInstance}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="&#x2713;" Foreground="{StaticResource Brush.Success}"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,2,0"
                                               Visibility="{Binding ShowUpToDate, Converter={StaticResource BoolVis}}"/>
                                    <Border Background="#66000000" CornerRadius="3" Padding="4,0" Margin="0,0,2,0"
                                            VerticalAlignment="Center"
                                            ToolTip="{x:Static vm:FamilyBrowserItemViewModel.UnknownToolTip}"
                                            Visibility="{Binding ShowUnknown, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="?" FontWeight="Bold" Foreground="{StaticResource Brush.TextMuted}"/>
                                    </Border>
                                    <Border Background="{StaticResource Brush.Accent}" CornerRadius="3"
                                            Padding="4,1" Margin="0,0,2,0" VerticalAlignment="Center"
                                            Visibility="{Binding ShowUpdateAvailable, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="&#x2191; Update" Foreground="White" FontSize="10"/>
                                    </Border>
                                    <Border Background="#66000000" CornerRadius="3" Padding="4,1" Margin="0,0,2,0"
                                            VerticalAlignment="Center"
                                            ToolTip="Loaded in the project but not found in the library"
                                            Visibility="{Binding IsModelOnly, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="&#x26A0;&#xFE0F;" FontSize="11"/>
                                    </Border>
                                    <Border Background="#66000000" CornerRadius="3" Padding="4,1" Margin="0,0,2,0"
                                            VerticalAlignment="Center"
                                            ToolTip="{Binding DuplicateToolTip}"
                                            Visibility="{Binding ShowDuplicate, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="&#x26A0;&#xFE0F;" FontSize="11"/>
                                    </Border>
                                    <Border Background="#66000000" CornerRadius="3" Padding="3,2" Margin="0,0,2,0"
                                            VerticalAlignment="Center"
                                            ToolTip="A fix is requested for this family"
                                            Visibility="{Binding IsFixRequested, Converter={StaticResource BoolVis}}">
                                        <Viewbox Width="13" Height="13">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{v:Icon tool}" Stroke="{StaticResource Brush.UpdateOrange}" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <Button Padding="3,0" BorderThickness="0"
                                            Background="#66000000" ToolTip="Toggle favourite"
                                            Command="{Binding DataContext.ToggleFavoriteCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <!-- No DB row behind a model-only family: no favourite to toggle. -->
                                                    <DataTrigger Binding="{Binding IsModelOnly}" Value="True">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#x2606;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Text" Value="&#x2605;"/>
                                                            <Setter Property="Foreground" Value="Gold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state: a blank list with no explanation reads as broken. Nothing found is
                 also exactly when a user may need a family the library doesn't have. -->
            <StackPanel Grid.Row="3" Margin="16" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredItems.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="11"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Text="No families to show. Remove some chips or clear the search, press &#x27F3; to check the open project, or run Scan in Settings if the library is new."/>
                <Button Margin="0,10,0,0" Padding="10,5" HorizontalAlignment="Center"
                        Command="{Binding RequestNewFamilyCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15" Margin="0,0,6,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="{v:Icon plus}" Stroke="{StaticResource Brush.Text}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Can't find it? Request a new family" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Rail footer: help/about + request a family (left) · busy note · requests,
                 grid-view toggle + settings (right) -->
            <Grid Grid.Row="4" Margin="6" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Width="30" Height="28" Padding="0" FontSize="13"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding ToggleHelpCommand}"
                        ToolTip="Help, info &amp; support"
                        Content="ℹ️"/>
                <!-- Its own button, never tied to the selected family. -->
                <Button Grid.Column="1" Height="28" Margin="4,0,0,0" Padding="5,0,8,0"
                        Command="{Binding RequestNewFamilyCommand}"
                        ToolTip="Ask for a family that is not in the library yet">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15" Margin="0,0,4,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="{v:Icon plus}" Stroke="{StaticResource Brush.Text}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Request family" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding BatchProgressText, TargetNullValue=Working…}" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis"
                               ToolTip="Revit or the library database is busy with your last action"/>
                    <TextBlock Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                               Visibility="{Binding IsBatchRunning, Converter={StaticResource BoolVis}}">
                        <Hyperlink Command="{Binding CancelBatchCommand}" Foreground="{StaticResource Brush.Accent}">Cancel</Hyperlink>
                    </TextBlock>
                </StackPanel>
                <!-- Read-only users browse a local copy of the library: say how fresh it is. -->
                <TextBlock Grid.Column="2" Text="{Binding LibraryStatus}" Margin="8,0" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextMuted}" FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding LibraryStatusDetail}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Grid-view toggle (2x2 squares). Hand-drawn vector to match the other icon-only
                     buttons in this window rather than an emoji. -->
                <!-- Requests (fixes and new families), with the open count as a badge. -->
                <ToggleButton Grid.Column="3" Width="30" Height="28" Padding="0" Margin="0,0,4,0"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              IsChecked="{Binding IsShowingRequests, Mode=OneWay}"
                              Command="{Binding ToggleRequestsCommand}"
                              ToolTip="{Binding RequestsButtonToolTip}">
                    <Grid>
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Data="{v:Icon inbox}" Stroke="{StaticResource Brush.Text}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <Border Margin="0,-9,-12,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                MinWidth="15" Height="15" Padding="3,0" CornerRadius="7.5"
                                Background="{StaticResource Brush.UpdateOrange}"
                                Visibility="{Binding HasOpenRequests, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding OpenRequestCount}" Foreground="White" FontSize="9"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </ToggleButton>
                <ToggleButton Grid.Column="4" Width="30" Height="28" Padding="0" Margin="0,0,4,0"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              IsChecked="{Binding IsGridView, Mode=TwoWay}"
                              ToolTip="Toggle grid view">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="3"  Canvas.Top="3"  Width="8" Height="8" RadiusX="1.5" RadiusY="1.5"
                                       Stroke="{StaticResource Brush.Text}" StrokeThickness="2"/>
                            <Rectangle Canvas.Left="13" Canvas.Top="3"  Width="8" Height="8" RadiusX="1.5" RadiusY="1.5"
                                       Stroke="{StaticResource Brush.Text}" StrokeThickness="2"/>
                            <Rectangle Canvas.Left="3"  Canvas.Top="13" Width="8" Height="8" RadiusX="1.5" RadiusY="1.5"
                                       Stroke="{StaticResource Brush.Text}" StrokeThickness="2"/>
                            <Rectangle Canvas.Left="13" Canvas.Top="13" Width="8" Height="8" RadiusX="1.5" RadiusY="1.5"
                                       Stroke="{StaticResource Brush.Text}" StrokeThickness="2"/>
                        </Canvas>
                    </Viewbox>
                </ToggleButton>
                <ToggleButton Grid.Column="5" Width="30" Height="28" Padding="0" FontSize="13"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              IsChecked="{Binding IsShowingSettings, Mode=OneWay}"
                              Command="{Binding ToggleSettingsCommand}"
                              ToolTip="Settings"
                              Content="⚙️"/>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

        <!-- ── RIGHT PANEL ─────────────────────────────────────────────── -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- FAMILY DETAIL (default view) -->
            <Grid Grid.Row="0" Grid.RowSpan="2"
                  Visibility="{Binding ShowDetailPane, Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,10,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="118"/>
                        <ColumnDefinition Width="Auto" MaxWidth="280"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="118" Height="118" VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            Background="{StaticResource Brush.Control}"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                        <Image Source="{Binding SelectedItem.Thumbnail}" Stretch="Uniform" Margin="3"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="10,0,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Margin="0,0,6,0" Padding="2,0" BorderThickness="0"
                                    Background="Transparent" ToolTip="Toggle favourite"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    CommandParameter="{Binding SelectedItem}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <!-- No DB row behind a model-only family: no favourite to toggle. -->
                                            <DataTrigger Binding="{Binding SelectedItem.IsModelOnly}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontSize="16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#x2606;"/>
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem.IsFavorite}" Value="True">
                                                    <Setter Property="Text" Value="&#x2605;"/>
                                                    <Setter Property="Foreground" Value="Gold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <TextBlock Text="{Binding SelectedItem.DisplayName}" FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Text="{Binding SelectedItem.Category}"
                                   Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                        <TextBlock Text="&#x26A0;&#xFE0F; Loaded in the project but not found in the library"
                                   Foreground="{StaticResource Brush.TextMuted}" FontSize="11"
                                   FontStyle="Italic" Margin="0,2,0,0"
                                   Visibility="{Binding SelectedItem.IsModelOnly,
                                                Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="{Binding ShowTags, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="&#x1F3F7;" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"
                                       Foreground="{StaticResource Brush.Accent}"/>
                            <ItemsControl ItemsSource="{Binding SelectedTagChips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TagChip}">
                                        <Button Margin="0,0,4,4" Padding="6,1" FontSize="11"
                                                Command="{Binding DataContext.FilterByTagCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Name}"
                                                ToolTip="{Binding ToolTip}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <!-- Built-in tags look different: worked out, never typed. -->
                                                        <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                            <Setter Property="Background" Value="#2D3A48"/>
                                                            <Setter Property="BorderBrush" Value="#4A6A8A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center"
                                                         Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolVis}}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="{v:Icon lock}" Stroke="{StaticResource Brush.Text}" StrokeThickness="2"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- Load / Update — one button, vertically centred against the thumbnail's
                         height; switches to "Update" + orange when a newer version exists. -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button Padding="16,7" FontWeight="SemiBold"
                            Command="{Binding LoadFamilyCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <!-- Content lives in the style: a local value would beat the trigger. -->
                                <Setter Property="Content" Value="Load"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowUpdateInProject}" Value="True">
                                        <Setter Property="Content" Value="Update"/>
                                        <Setter Property="Background" Value="{StaticResource Brush.UpdateOrange}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.UpdateOrange}"/>
                                    </DataTrigger>
                                    <!-- A model-only family has no .rfa to load from — a permanently
                                         disabled button would just look broken, so hide it. -->
                                    <DataTrigger Binding="{Binding SelectedItem.IsModelOnly}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Save to Library — the model-only counterpart of Load: writes the family
                         from the model into the library folder so the library can be grown from
                         the project. -->
                    <!-- View-only users can't write the library: theirs suggests the family instead. -->
                    <Button Padding="16,7" FontWeight="SemiBold" Content="{Binding SaveToLibraryLabel}"
                            Command="{Binding SaveToLibraryCommand}"
                            ToolTip="{Binding SaveToLibraryToolTip}"
                            Visibility="{Binding SelectedItem.IsModelOnly, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>

                    <!-- Request a fix — for library families, open to everyone (view-only users too). -->
                    <Button Margin="0,6,0,0" Padding="8,4" FontSize="11"
                            Command="{Binding RequestFixCommand}"
                            ToolTip="Tell the library maintainer this family needs fixing or changing">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem.IsModelOnly}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,5,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{v:Icon tool}" Stroke="{StaticResource Brush.Text}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Request a fix" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    </StackPanel>

                    <!-- Rescan / Edit Info / Open — top-right corner of the panel, stacked -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Top">
                        <Button Width="30" Height="28" Margin="0,0,0,4" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding RescanFamilyCommand}"
                                ToolTip="Re-read this family's parameters and thumbnail from disk">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <!-- No .rfa / DB row behind a model-only family: nothing to rescan. -->
                                        <DataTrigger Binding="{Binding SelectedItem.IsModelOnly}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <!-- View-only library access: nothing to rescan or edit. -->
                                        <DataTrigger Binding="{Binding CanEdit}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{StaticResource Brush.Text}"
                                          Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Width="30" Height="28" Margin="0,0,0,4" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding EditInfoCommand}"
                                ToolTip="Edit Info">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <!-- No DB row behind a model-only family: no info to edit. -->
                                        <DataTrigger Binding="{Binding SelectedItem.IsModelOnly}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <!-- View-only library access: nothing to rescan or edit. -->
                                        <DataTrigger Binding="{Binding CanEdit}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="4" Canvas.Top="3" Width="13" Height="18"
                                               Stroke="{StaticResource Brush.Text}" StrokeThickness="1.6"/>
                                    <Path Stroke="{StaticResource Brush.Text}" StrokeThickness="1.6"
                                          Data="M7.5 8 L13.5 8 M7.5 12 L11 12"/>
                                    <Path Fill="{StaticResource Brush.Text}"
                                          Data="M14.5 16.5 L19.5 11.5 L21.7 13.7 L16.7 18.7 L14.5 18.7 Z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Width="30" Height="28" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding OpenFamilyEditorCommand}"
                                ToolTip="Open in Family Editor (model-only families open from the model)">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{StaticResource Brush.Text}" StrokeThickness="1.6"
                                          Data="M10 4 L5 4 L5 20 L19 20 L19 15"/>
                                    <Path Stroke="{StaticResource Brush.Text}" StrokeThickness="1.6"
                                          Data="M14 4 L20 4 L20 10 M20 4 L11 13"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Open fix requests on this family: who asked, when, what they wrote. -->
                <Border Grid.Row="1" Margin="12,0,12,8" Padding="10,8" CornerRadius="2"
                        Background="#3A3122" BorderBrush="#6A5530" BorderThickness="1"
                        Visibility="{Binding HasSelectedFamilyRequests, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Viewbox Width="15" Height="15" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding SelectedRequestsIcon, Converter={StaticResource IconByName}}"
                                          Stroke="#F0C070" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding SelectedRequestsTitle}" FontWeight="SemiBold" Foreground="#F0C070"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding SelectedFamilyRequests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RequestItemViewModel}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Meta}" FontSize="10" Foreground="#B8A888"/>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FlowDirection="{Binding TextFlowDirection}"
                                                       Visibility="{Binding HasText, Converter={StaticResource BoolVis}}"/>
                                            <TextBlock FontSize="10" Foreground="#B8A888" Text="&#x1F4CE; Their project's version is attached"
                                                       Visibility="{Binding ShowAttachmentNote, Converter={StaticResource BoolVis}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                            <Button Content="{Binding DoneLabel}" Padding="8,2" FontSize="11" ToolTip="{Binding DoneToolTip}"
                                                    Visibility="{Binding CanMarkDone, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.MarkRequestDoneCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Withdraw" Padding="8,2" FontSize="11" Margin="4,0,0,0"
                                                    ToolTip="Take back your request"
                                                    Visibility="{Binding CanWithdraw, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.WithdrawRequestCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TabControl Grid.Row="2" Margin="12,0,12,10">
                    <TabItem Header="Instructions">
                        <RichTextBox IsReadOnly="True" IsDocumentEnabled="True"
                                     ctrl:RichTextBoxHelper.DocumentXaml="{Binding InstructionsXaml}"/>
                    </TabItem>
                    <TabItem Header="{Binding FilteredParameters.Count, StringFormat='Parameters ({0})'}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" Margin="0,0,0,4"
                                     Text="{Binding ParameterFilter, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Filter parameters by name, group, or kind"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredParameters}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name"  Binding="{Binding ParameterName}" Width="*"/>
                                    <DataGridTextColumn Header="Group" Binding="{Binding ParamGroup}"    Width="130"/>
                                    <DataGridTemplateColumn Header="Kind" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="1" CornerRadius="8" Padding="6,1"
                                                        HorizontalAlignment="Left" Background="Transparent">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Shared">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="System">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Success}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Kind}" FontSize="9.5" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Shared">
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="System">
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Success}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Type"  Binding="{Binding DataType}"      Width="100"/>
                                    <DataGridCheckBoxColumn Header="Inst." Binding="{Binding IsInstance}" Width="46"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- SETTINGS (embedded — replaces the old ribbon Config window) -->
            <ScrollViewer Grid.Row="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsShowingSettings, Converter={StaticResource BoolVis}}">
                <StackPanel Margin="22,20,22,22" MaxWidth="480" HorizontalAlignment="Left"
                            DataContext="{Binding Settings}">
                    <TextBlock Text="Settings" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="Family Library" Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="11" Margin="0,2,0,20"/>

                    <TextBlock Text="LIBRARY ROOT FOLDER"
                               Foreground="{StaticResource Brush.TextMuted}" FontSize="10"
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" IsReadOnly="True" Margin="0,0,6,0"
                                 Text="{Binding LibraryFolderPath, Mode=OneWay}"
                                 Foreground="{StaticResource Brush.TextMuted}"/>
                        <Button Grid.Column="1" Content="Browse…" Width="72"
                                Command="{Binding BrowseLibraryCommand}"/>
                    </Grid>
                    <TextBlock Foreground="{StaticResource Brush.TextMuted}" FontSize="10"
                               Margin="0,5,0,0" TextWrapping="Wrap">
                        The .DB folder with the database will be created here automatically.
                    </TextBlock>

                    <Separator Margin="0,26,0,22"/>

                    <TextBlock Text="SCAN" Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"
                               Foreground="{StaticResource Brush.Text}">
                        Scan always adds new families and removes ones whose files are gone.
                        Check a box to also refresh that data for anything new, changed, or
                        currently missing it — nothing else is touched.
                        <LineBreak/><LineBreak/>
                        <Run FontWeight="SemiBold">Update thumbnails</Run> re-reads each family's
                        preview image — a fast, plain file read.
                        <LineBreak/>
                        <Run FontWeight="SemiBold">Update parameters</Run> re-reads category and
                        parameters using the Revit engine — slower.
                        <LineBreak/><LineBreak/>
                        Your instructions, pictures, custom thumbnails, tags, and favourites are
                        always kept.
                    </TextBlock>
                    <CheckBox Content="Update thumbnails" Margin="0,0,0,8"
                              IsChecked="{Binding ScanThumbnails}"/>
                    <CheckBox Content="Update parameters (slower)" Margin="0,0,0,14"
                              IsChecked="{Binding ScanParameters}"/>
                    <Button Command="{Binding ScanCommand}"
                            HorizontalAlignment="Left"
                            Padding="14,7" Background="{StaticResource Brush.AccentDark}"
                            BorderBrush="{StaticResource Brush.Accent}"
                            Content="Scan"/>
                    <TextBlock Foreground="{StaticResource Brush.TextMuted}" FontSize="10"
                               Margin="0,5,0,0" TextWrapping="Wrap"
                               Visibility="{Binding IsReadOnlyLibrary, Converter={StaticResource BoolVis}}">
                        You have view-only access to this library, so only its maintainer can scan it.
                    </TextBlock>

                    <Separator Margin="0,26,0,22"/>

                    <!-- Office keyboard shortcuts: .DB\KeyboardShortcuts.xml (Core's OfficeShortcuts). -->
                    <TextBlock Text="KEYBOARD SHORTCUTS" Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Install office shortcuts" Padding="12,6"
                                Command="{Binding InstallShortcutsCommand}"
                                ToolTip="Replace your Revit keyboard shortcuts with the office's"/>
                        <Button Content="Publish my shortcuts" Padding="12,6" Margin="6,0,0,0"
                                Command="{Binding PublishShortcutsCommand}"
                                ToolTip="Make your own Revit keyboard shortcuts the office's">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <!-- Only the maintainer can write the library. -->
                                        <DataTrigger Binding="{Binding IsReadOnlyLibrary}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource Brush.TextMuted}" FontSize="10"
                               Margin="0,5,0,0" TextWrapping="Wrap">
                        Install replaces your shortcuts in every Revit version on this PC with the office's;
                        your old ones are kept as a backup file next to them. Restart Revit to use them.
                    </TextBlock>

                    <Separator Margin="0,26,0,22"/>

                    <TextBlock Text="IGNORED SUBFOLDERS" Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox AcceptsReturn="True" Height="80"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding IgnoredSubfoldersText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Foreground="{StaticResource Brush.TextMuted}" FontSize="10"
                               Margin="0,5,0,0" TextWrapping="Wrap">
                        One subfolder per line, relative to the library root. Families under these
                        folders are skipped by scans and hidden in the browser; their existing data
                        is kept.
                    </TextBlock>

                    <TextBlock Text="IGNORED FILES (REGEX)" Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="10" FontWeight="SemiBold" Margin="0,18,0,8"/>
                    <TextBox AcceptsReturn="True" Height="60"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             Text="{Binding IgnoredFilePatternsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Foreground="{StaticResource Brush.TextMuted}" FontSize="10"
                               Margin="0,5,0,0" TextWrapping="Wrap">
                        One regular expression per line, matched against the file name. Matching
                        families are skipped by scans and hidden in the browser; their existing
                        data is kept. The default pattern .*\.\d{4}\.rfa hides Revit backup files
                        (e.g. Door.0001.rfa). Invalid expressions are ignored.
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <!-- HELP / ABOUT (markdown, fetched from the docs repo) -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Margin="16"
                  Visibility="{Binding IsShowingHelp, Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding HelpSourceLabel}"
                           Foreground="{StaticResource Brush.TextDisabled}" FontSize="10"
                           Margin="0,0,0,10" TextWrapping="Wrap"/>
                <RichTextBox Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0"
                             VerticalScrollBarVisibility="Auto"
                             ctrl:RichTextBoxHelper.MarkdownSource="{Binding HelpMarkdownRaw}"/>
            </Grid>

            <!-- REQUESTS (fixes and new families; files in the library's .Requests folder) -->
            <ScrollViewer Grid.Row="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsShowingRequests, Converter={StaticResource BoolVis}}">
                <StackPanel Margin="18,14,18,18">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Padding="10,5" Command="{Binding RequestNewFamilyCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15" Height="15" Margin="0,0,5,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{v:Icon plus}" Stroke="{StaticResource Brush.Text}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Request a new family" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Requests" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding RequestsIntro}" Margin="0,8,0,12" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.TextMuted}"/>

                    <TextBlock Text="{Binding NewFamilyRequestsTitle}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,6"/>
                    <TextBlock Text="None open." FontSize="11" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,6"
                               Visibility="{Binding HasNoNewFamilyRequests, Converter={StaticResource BoolVis}}"/>
                    <ItemsControl ItemsSource="{Binding NewFamilyRequests}" ItemTemplate="{StaticResource RequestCard}"/>

                    <TextBlock Text="{Binding SuggestedFamilyRequestsTitle}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextMuted}" Margin="0,12,0,6"/>
                    <TextBlock Text="None open." FontSize="11" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,6"
                               Visibility="{Binding HasNoSuggestedFamilyRequests, Converter={StaticResource BoolVis}}"/>
                    <ItemsControl ItemsSource="{Binding SuggestedFamilyRequests}" ItemTemplate="{StaticResource RequestCard}"/>

                    <TextBlock Text="{Binding FixRequestsTitle}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextMuted}" Margin="0,12,0,6"/>
                    <TextBlock Text="None open." FontSize="11" Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,6"
                               Visibility="{Binding HasNoFixRequests, Converter={StaticResource BoolVis}}"/>
                    <ItemsControl ItemsSource="{Binding FixRequests}" ItemTemplate="{StaticResource RequestCard}"/>

                    <TextBlock Text="{Binding DoneRequestsLine}" FontSize="10" Margin="0,10,0,0"
                               Foreground="{StaticResource Brush.TextMuted}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</Window>
