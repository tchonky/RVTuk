<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RVTuk.UI</AssemblyName>
    <RootNamespace>RVTuk.UI</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release2023'">
    <TargetFramework>net48</TargetFramework>
    <OutputPath>bin\2023\Release2023\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release2024'">
    <TargetFramework>net48</TargetFramework>
    <OutputPath>bin\2024\Release2024\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'!='Release2024' and '$(Configuration)'!='Release2023'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputPath>bin\2025\Release2025\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RVTuk.Core\RVTuk.Core.csproj" />
  </ItemGroup>

  <!-- net48 doesn't implicitly resolve System.Net.Http (used for the Help panel's markdown
       fetch) — a transitive package pulls in a facade at a different version, so the compiler
       needs an explicit reference to disambiguate. -->
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
