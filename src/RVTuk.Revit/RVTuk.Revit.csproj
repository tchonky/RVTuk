<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RVTuk.Revit</AssemblyName>
    <RootNamespace>RVTuk.Revit</RootNamespace>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- One Revit year per configuration: Release2024 -> 2024 (net48), Release2025 -> 2025
       (net8), Release2027 -> 2027 (net10). RVTuk does not build for 2023 or 2026 — KKarea
       serves those years. -->
  <PropertyGroup>
    <RevitYear>2025</RevitYear>
    <RevitYear Condition="'$(Configuration)'=='Release2024'">2024</RevitYear>
    <RevitYear Condition="'$(Configuration)'=='Release2027'">2027</RevitYear>
    <OutputPath>bin\$(RevitYear)\Release$(RevitYear)\</OutputPath>
    <DefineConstants>REVIT$(RevitYear)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitYear)'=='2024'">
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitYear)'=='2025'">
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitYear)'=='2027'">
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitYear)'!='2024'">
    <!-- net8/net10 libraries don't copy NuGet deps to bin by default (they rely on deps.json
         resolution). A Revit add-in is loaded by Revit.exe, so it must carry its own
         dependency closure — including runtimes\win-x64\native\e_sqlite3.dll — into bin
         for Deploy.ps1 to pick up. (net48 already copies deps, so this only matters here.) -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Revit API packages for the configured year: compile-time only, the real DLLs come
       from the Revit install. -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI"
                      Version="$(RevitYear).*"
                      IncludeAssets="compile;build;native;contentfiles;analyzers;buildtransitive"
                      ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI"
                      Version="$(RevitYear).*"
                      IncludeAssets="compile;build;native;contentfiles;analyzers;buildtransitive"
                      ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RVTuk.Core\RVTuk.Core.csproj" />
    <ProjectReference Include="..\RVTuk.UI\RVTuk.UI.csproj" />
  </ItemGroup>

  <!-- net48: System.Drawing from the GAC (same rationale as RVTuk.Core) — needed for
       ElementType.GetPreviewImage's Bitmap in GetFamilyPreviewsEventHandler. On net8 the
       System.Drawing.Common types flow transitively from RVTuk.Core's package reference. -->
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
