<UserControl x:Class="RVTuk.UI.TopoTools.Views.TopoToolsPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RVTuk.UI;component/Shared/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource Brush.Bg}" LastChildFill="True">

        <!-- Settings on the left, the two verbs on the right: the run button sits beside what it
             will use rather than at the far end of the pane. -->
        <Grid DockPanel.Dock="Top" Margin="10,10,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="ACTIVE VIEW"
                           Foreground="{StaticResource Brush.TextMuted}"
                           FontSize="10" FontWeight="SemiBold"
                           Margin="0,0,0,2"/>
                <!-- Green when this view has topo lines, red when it has none: which view you are
                     in is the first thing to get wrong, and the fastest thing to show. -->
                <TextBlock Text="{Binding ViewName}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLines}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="POINT SPACING (CM)"
                           Foreground="{StaticResource Brush.TextMuted}"
                           FontSize="10" FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding SpacingCentimetres, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         KeyDown="OnEditorKeyDown"
                         HorizontalAlignment="Left" Width="90"
                         ToolTip="Distance between generated points along each line, in centimetres."/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="10,0,0,0">
                <Button Command="{Binding ApplyCommand}"
                        Width="40" Height="40" FontSize="17"
                        Content="&#x25B6;"
                        ToolTip="Apply Points — put points at each line's height on the toposolid below it"/>
                <Button Command="{Binding RefreshCommand}"
                        Width="40" Height="40" FontSize="17"
                        Content="&#x27F3;" Margin="6,0,0,0"
                        ToolTip="Refresh — re-read this view's topo lines"/>
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="10,8">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource Brush.TextMuted}"
                       FontSize="11" TextWrapping="Wrap"/>
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Text="TOPO LINES IN THIS VIEW — SET EACH HEIGHT HERE"
                   Foreground="{StaticResource Brush.TextMuted}"
                   FontSize="10" FontWeight="SemiBold"
                   Margin="10,0,10,4"/>

        <!-- Highlighting a row IS selecting the line: the ListBox's own selection is bound straight
             to each row, and the pane mirrors it into Revit and back. Extended mode so Ctrl and
             Shift pick several, which is also what makes one typed height set them all. -->
        <ListBox ItemsSource="{Binding Lines}"
                 SelectionMode="Extended"
                 Background="{StaticResource Brush.Input}"
                 Margin="10,0,10,8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ToolTip="Click a row to select its line in the view. Ctrl-click for several — then a height typed into any one of them sets them all.">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,1">
                        <DockPanel LastChildFill="True">
                            <TextBox Text="{Binding ElevationText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     KeyDown="OnEditorKeyDown"
                                     DockPanel.Dock="Right"
                                     Width="86" TextAlignment="Right"
                                     ToolTip="This line's height, in the project's units. Press Enter to apply. Clear it to un-set the height."/>
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="{StaticResource Brush.Text}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                        </DockPanel>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
