<Window x:Class="RVTuk.UI.FamilyBrowser.Views.RequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:RVTuk.UI.Shared.Themes"
        Title="RVTuk — Request"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:DarkThemeDictionary/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Background><StaticResource ResourceKey="Brush.Bg"/></Window.Background>
    <Window.Foreground><StaticResource ResourceKey="Brush.Text"/></Window.Foreground>

    <StackPanel Margin="14,12,14,12">
        <Label x:Name="PromptLabel" Target="{Binding ElementName=RequestText}" Padding="0" Margin="0,0,0,6"
               FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextMuted}"/>
        <Grid>
            <!-- Hebrew is welcome: the box follows the direction of what is typed. -->
            <TextBox x:Name="RequestText" Height="130" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="4"
                     TextChanged="RequestText_TextChanged"/>
            <TextBlock x:Name="Placeholder" Margin="8,6,8,0" VerticalAlignment="Top" TextWrapping="Wrap"
                       FontSize="11" Foreground="{StaticResource Brush.TextMuted}" IsHitTestVisible="False"/>
        </Grid>

        <CheckBox x:Name="AttachBox" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Attach my project's version of this family"/>
                <TextBlock x:Name="AttachHint" FontSize="10" TextWrapping="Wrap" MaxWidth="420"
                           Foreground="{StaticResource Brush.TextMuted}"/>
            </StackPanel>
        </CheckBox>

        <TextBlock Margin="0,10,0,0" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}"
                   Text="Your Windows user name and today's date are added. The library maintainer sees it once Desktop Connector has uploaded it, usually within a minute."/>

        <Separator Margin="0,10,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,6,0" IsCancel="True"/>
            <Button x:Name="SendButton" Content="Send" Width="80" FontWeight="SemiBold" IsDefault="False"
                    IsEnabled="False" Click="Send_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
